 const VC_MAX_FAMILY_STEPS = 25; // guards against a tiny/zero step spawning huge numbers of traces
 
+/* ---------- fixed y-axis for single pulses ----------
+   Before a single pulse is drawn, the same protocol is simulated silently for
+   every Pulse-1 potential from VC_SWEEP_VMIN up to VC_VMAX (+70 mV). The extremes
+   of those hidden sweeps set the current (and conductance) axes, so the axes
+   already have room for any pulse a student can apply and overlaid traces never
+   rescale. With overlay on, the lock only grows (union with the previous lock),
+   so a parameter change (e.g. TTX) never clips traces that are still on screen. */
+const VC_SWEEP_VMIN = -120, VC_SWEEP_STEP = 5;
+const VC_LOCKED_AXES = ['vcyCurrent', 'vcyCond'];
+let vcYLock = {};           // axis id -> { min, max } (unpadded data range)
+
+function vcEnvelope(runs){
+  const env = {};
+  VC_VAR_CONFIG.forEach(cfg => {
+    if (!VC_LOCKED_AXES.includes(cfg.axis) || !el(cfg.chk).checked) return;
+    const e = env[cfg.axis] || (env[cfg.axis] = { min: Infinity, max: -Infinity });
+    runs.forEach(run => {
+      for (const v of run[cfg.key]){
+        if (isFinite(v)){ if (v < e.min) e.min = v; if (v > e.max) e.max = v; }
+      }
+    });
+  });
+  return env;
+}
+
+function vcSweepEnvelope(p, Vtest){
+  const vs = [];
+  for (let v = VC_SWEEP_VMIN; v <= VC_VMAX + 1e-9; v += VC_SWEEP_STEP) vs.push(v);
+  if (!vs.includes(Vtest)) vs.push(Vtest); // exact peak of the pulse actually applied
+  return vcEnvelope(vs.map(V => HH.simulateVoltageClamp(p, V)));
+}
+
+function vcApplyYLock(env, keepOverlay){
+  const next = {};
+  VC_LOCKED_AXES.forEach(ax => {
+    const e = env[ax], prev = keepOverlay ? vcYLock[ax] : null;
+    if (e && isFinite(e.min) && isFinite(e.max)){
+      next[ax] = prev ? { min: Math.min(prev.min, e.min), max: Math.max(prev.max, e.max) } : { min: e.min, max: e.max };
+    } else if (prev){
+      next[ax] = prev;
+    }
+    const sc = vcMainChart.options.scales[ax];
+    if (next[ax]){
+      // pad 3 % and round outward to a "nice" tick step so the end labels read cleanly
+      const span = Math.max(next[ax].max - next[ax].min, 1e-6);
+      const raw = span / 6, mag = Math.pow(10, Math.floor(Math.log10(raw)));
+      const step = [1, 2, 2.5, 5, 10].find(f => f * mag >= raw) * mag;
+      sc.min = Math.floor((next[ax].min - 0.03 * span) / step) * step;
+      sc.max = Math.ceil((next[ax].max + 0.03 * span) / step) * step;
+    } else {
+      sc.min = undefined;
+      sc.max = undefined;
+    }
+  });
+  // gating axis keeps its fixed 0–1 range
+  vcMainChart.options.scales.vcyGate.min = 0;
+  vcMainChart.options.scales.vcyGate.max = 1;
+  vcYLock = next;
+}
+
